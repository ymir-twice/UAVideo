# ============================================
# Video Understanding Agent Configuration
# ============================================

# Server
HOST=0.0.0.0
PORT=18080
AUTH_TOKEN=sk-admin

# Core LLM (Doubao - Language Reasoning Only)
CORE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CORE_LLM_API_KEY=your-api-key-here
CORE_LLM_MODEL=doubao-seed-1-8-251228
CORE_LLM_TIMEOUT=180

# Local vLLM (Vision Tools)
# Deploy Qwen3-VL-4B and Qwen3-ASR-1.7B with vLLM
VLLM_BASE_URL=http://localhost:8008/v1
VLLM_API_KEY=EMPTY
VLLM_CAPTION_MODEL=Qwen3-VL-4B
VLLM_ASR_MODEL=Qwen3-ASR-1.7B

# Cache & Storage
CACHE_DIR=/mnt/data/gk/.cache/tool_agent
SESSION_STORAGE_DIR=/mnt/data/gk/.cache/tool_agent/sessions

# Frame Extraction
MAX_FRAMES=16
ADAPTIVE_THRESHOLD=0.3
MAX_EVIDENCE_CHARS=12000

# Tools (vLLM-based)
CAPTION_ENABLED=true
ASR_ENABLED=true

# Memory Configuration
SHORT_TERM_WINDOW_SIZE=50
SHORT_TERM_MAX_AGE=300
LONG_TERM_MAX_SEGMENTS=20
